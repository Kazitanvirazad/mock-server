<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.server.app</groupId>
    <artifactId>mockserver-app</artifactId>
    <name>MockServer-App</name>
    <description>Cross platform MockServer desktop application to create and run mock servers locally for testing
    </description>

    <parent>
        <groupId>com.server</groupId>
        <artifactId>mockserver</artifactId>
        <version>1.2</version>
    </parent>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/Kazitanvirazad/mock-server/blob/master/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Kazitanvirazad</id>
            <name>Kazi Tanvir Azad</name>
            <email>tanvir.kaziazad@gmail.com</email>
            <roles>
                <role>Java Developer</role>
            </roles>
            <url>https://www.linkedin.com/in/kazitanvirazad/</url>
        </developer>
    </developers>

    <properties>
        <signing.keystore>${env.MOCKSERVER_JARSIGN_KEYSTORE}</signing.keystore>
        <signing.alias>${env.MOCKSERVER_JARSIGN_ALIAS}</signing.alias>
        <signing.storepass>${env.MOCKSERVER_JARSIGN_STOREPASS}</signing.storepass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.server.core</groupId>
            <artifactId>mockserver-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>MockServer</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>
                                ${project.build.directory}/libs
                            </outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>libs/</classpathPrefix>
                            <mainClass>
                                com.server.app.Launcher
                            </mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/server/app/Launcher.class</exclude>
                                <exclude>com/server/app/MockServerApp.class</exclude>
                                <exclude>com/server/app/config/**</exclude>
                                <exclude>com/server/app/constants/**</exclude>
                                <exclude>com/server/app/control/**</exclude>
                                <exclude>com/server/app/controller/**</exclude>
                                <exclude>com/server/app/event/**</exclude>
                                <exclude>com/server/app/exception/**</exclude>
                                <exclude>com/server/app/fxml/**</exclude>
                                <exclude>com/server/app/model/**</exclude>
                                <exclude>com/server/app/function/**</exclude>
                                <exclude>com/server/app/notification/**</exclude>
                                <exclude>com/server/app/service/TableDataService.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/server/app/Launcher.class</exclude>
                                <exclude>com/server/app/MockServerApp.class</exclude>
                                <exclude>com/server/app/config/**</exclude>
                                <exclude>com/server/app/constants/**</exclude>
                                <exclude>com/server/app/control/**</exclude>
                                <exclude>com/server/app/controller/**</exclude>
                                <exclude>com/server/app/event/**</exclude>
                                <exclude>com/server/app/exception/**</exclude>
                                <exclude>com/server/app/fxml/**</exclude>
                                <exclude>com/server/app/model/**</exclude>
                                <exclude>com/server/app/function/**</exclude>
                                <exclude>com/server/app/notification/**</exclude>
                                <exclude>com/server/app/service/TableDataService.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>gpg-sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jar-sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jarsigner-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-application-jar</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <archive>${project.build.directory}/${project.build.finalName}.jar</archive>
                            <keystore>${signing.keystore}</keystore>
                            <alias>${signing.alias}</alias>
                            <storepass>${signing.storepass}</storepass>
                            <verbose>true</verbose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>